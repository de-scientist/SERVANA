# PostgreSQL
DATABASE_URL=postgresql://servana:8656@localhost:5432/servana?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# App
APP_NAME=SERVANA
APP_ENV=development
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Auth (CHANGE IN PRODUCTION)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
BCRYPT_ROUNDS=10

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRIVATE=servana-private
S3_BUCKET_PUBLIC=servana-public
S3_PUBLIC_URL=http://localhost:9000/servana-public

# Payments (adapter stubs; real keys later)
PAYMENT_DEFAULT_PROVIDER=stub
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
MPESA_WEBHOOK_SECRET=

# Notifications (adapter stubs)
EMAIL_API_KEY=
SMS_API_KEY=
PUSH_API_KEY=
WHATSAPP_API_TOKEN=

# AI (adapter stubs)
AI_DEFAULT_PROVIDER=stub
AI_PROVIDER_OPENAI_KEY=
AI_PROVIDER_ANTHROPIC_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small

# Observability
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
